// ============================================================================
// Neo4j Psychiatric Knowledge Graph Schema & CBT Literature Ontology
// Paper: Bridging the Gap Between Wearable Sensors and Clinical Practice in Agoraphobia and Panic Disorder: Single-Case Formative Evaluation of a Multi-Stage Large Language Model Pipeline
// Agoraphobia, Panic Disorder, Wearable Telemetry, and CBT Interventions
// ============================================================================

// 1. CONSTRAINTS & INDEXES
CREATE CONSTRAINT unique_entity_id IF NOT EXISTS FOR (e:Entity) REQUIRE e.entity_id IS UNIQUE;
CREATE INDEX entity_id_index IF NOT EXISTS FOR (e:Entity) ON (e.entity_id);
CREATE INDEX entity_type_index IF NOT EXISTS FOR (e:Entity) ON (e.entity_type);

// 2. ONTOLOGY NODES (117 Clinical & Physiological Entities)
MERGE (e:Entity:Disorder_Category {entity_id: "DC001"}) ON CREATE SET e.name = "Anxiety Disorders (General)", e.type = "Disorder_Category", e.definition = "A category of mental health disorders characterized by feelings of anxiety and fear. Anxiety is a worry about future events, and fear is a reaction to current events. These disorders cause significant distress or impairment in functioning.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD001"}) ON CREATE SET e.name = "Generalized Anxiety Disorder", e.type = "Anxiety_Disorder", e.definition = "A disorder characterized by persistent, excessive, and unrealistic worry about everyday things.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD002"}) ON CREATE SET e.name = "Social Anxiety Disorder", e.type = "Anxiety_Disorder", e.definition = "A disorder characterized by intense fear or anxiety in social situations where one might be scrutinized by others.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD003"}) ON CREATE SET e.name = "Panic Disorder", e.type = "Anxiety_Disorder", e.definition = "A disorder characterized by recurrent unexpected panic attacks, which are sudden periods of intense fear or discomfort.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD004"}) ON CREATE SET e.name = "Specific Phobia", e.type = "Anxiety_Disorder", e.definition = "A disorder characterized by an intense, irrational fear of a specific object or situation.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD005"}) ON CREATE SET e.name = "Separation Anxiety Disorder", e.type = "Anxiety_Disorder", e.definition = "A disorder characterized by excessive fear or anxiety concerning separation from home or attachment figures.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD006"}) ON CREATE SET e.name = "Selective Mutism", e.type = "Anxiety_Disorder", e.definition = "A complex childhood anxiety disorder characterized by a child's inability to speak and communicate effectively in select social settings, such as school.", e.created_at = timestamp();
MERGE (e:Entity:Anxiety_Disorder {entity_id: "AD007"}) ON CREATE SET e.name = "Agoraphobia", e.type = "Anxiety_Disorder", e.definition = "A disorder characterized by fear and avoidance of situations where escape might be difficult or help unavailable if panic-like symptoms occur.", e.created_at = timestamp();
MERGE (e:Entity:Disorder_Related {entity_id: "DR001"}) ON CREATE SET e.name = "Obsessive-Compulsive Disorder", e.type = "Disorder_Related", e.definition = "A disorder characterized by persistent, unwanted thoughts (obsessions) and/or repetitive behaviors (compulsions). Often co-occurs with anxiety disorders.", e.created_at = timestamp();
MERGE (e:Entity:Disorder_Related {entity_id: "DR002"}) ON CREATE SET e.name = "Posttraumatic Stress Disorder", e.type = "Disorder_Related", e.definition = "A disorder that develops in some people who have experienced a shocking, scary, or dangerous event. Characterized by intrusive memories, avoidance, negative changes in thinking and mood, and changes in physical and emotional reactions.", e.created_at = timestamp();
MERGE (e:Entity:Disorder_Related {entity_id: "DR003"}) ON CREATE SET e.name = "Body Dysmorphic Disorder", e.type = "Disorder_Related", e.definition = "A mental health condition where a person spends a lot of time worrying about flaws in their appearance. These flaws are often unnoticeable to others. (Often related to OCD)", e.created_at = timestamp();
MERGE (e:Entity:Disorder_Related {entity_id: "DR004"}) ON CREATE SET e.name = "Trichotillomania (Hair-Pulling Disorder)", e.type = "Disorder_Related", e.definition = "A disorder that involves recurrent, irresistible urges to pull out hair from your scalp, eyebrows or other areas of your body, despite trying to stop. (Often related to OCD)", e.created_at = timestamp();
MERGE (e:Entity:Disorder_Related {entity_id: "DR005"}) ON CREATE SET e.name = "Excoriation (Skin-Picking Disorder)", e.type = "Disorder_Related", e.definition = "A disorder characterized by recurrent, compulsive picking of skin leading to skin lesions and significant distress or impairment. (Often related to OCD)", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Cognitive {entity_id: "SC001"}) ON CREATE SET e.name = "Excessive Worry", e.type = "Symptom_Cognitive", e.definition = "Persistent, difficult-to-control worrying about multiple topics or situations, often disproportionate to the actual likelihood or impact of the feared events.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Cognitive {entity_id: "SC002"}) ON CREATE SET e.name = "Repetitive Negative Thinking", e.type = "Symptom_Cognitive", e.definition = "A style of thinking characterized by recurrent, intrusive, and typically negative thoughts about oneself, the past, or the future.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Cognitive {entity_id: "SC003"}) ON CREATE SET e.name = "Obsessions", e.type = "Symptom_Cognitive", e.definition = "Recurrent and persistent thoughts, urges, or images that are experienced as intrusive and unwanted, causing marked anxiety or distress.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Cognitive {entity_id: "SC004"}) ON CREATE SET e.name = "Fear of Negative Evaluation", e.type = "Symptom_Cognitive", e.definition = "A cognitive characteristic involving apprehension and distress related to being judged negatively by others.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Cognitive {entity_id: "SC005"}) ON CREATE SET e.name = "Intolerance of Uncertainty", e.type = "Symptom_Cognitive", e.definition = "A cognitive bias that affects how a person perceives, interprets, and responds to uncertain situations on a cognitive, emotional, and behavioral level.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Cognitive {entity_id: "SC006"}) ON CREATE SET e.name = "Catastrophic Misinterpretation", e.type = "Symptom_Cognitive", e.definition = "The tendency to interpret ambiguous bodily sensations or situations as signs of imminent danger or catastrophe.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Physical {entity_id: "SP001"}) ON CREATE SET e.name = "Palpitations", e.type = "Symptom_Physical", e.definition = "Feelings of having a fast-beating, fluttering, or pounding heart.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Physical {entity_id: "SP002"}) ON CREATE SET e.name = "Sweating", e.type = "Symptom_Physical", e.definition = "Excessive perspiration, often in response to stress or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Physical {entity_id: "SP003"}) ON CREATE SET e.name = "Muscle Tension", e.type = "Symptom_Physical", e.definition = "A state where muscles remain semi-contracted for an extended period, often associated with stress and anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Physical {entity_id: "SP004"}) ON CREATE SET e.name = "Shortness of Breath", e.type = "Symptom_Physical", e.definition = "A sensation of not being able to get enough air, also known as dyspnea.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Physical {entity_id: "SP005"}) ON CREATE SET e.name = "Trembling/Shaking", e.type = "Symptom_Physical", e.definition = "Involuntary quivering or shaking of the body or limbs.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Physical {entity_id: "SP006"}) ON CREATE SET e.name = "Fatigue", e.type = "Symptom_Physical", e.definition = "A persistent feeling of tiredness, weariness, or lack of energy.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral {entity_id: "SB001"}) ON CREATE SET e.name = "Avoidance Behavior", e.type = "Symptom_Behavioral", e.definition = "Actions taken to escape from or prevent exposure to feared objects, situations, thoughts, or feelings.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral {entity_id: "SB002"}) ON CREATE SET e.name = "Compulsions", e.type = "Symptom_Behavioral", e.definition = "Repetitive behaviors or mental acts that an individual feels driven to perform in response to an obsession or according to rules that must be applied rigidly.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral {entity_id: "SB003"}) ON CREATE SET e.name = "Safety Behaviors", e.type = "Symptom_Behavioral", e.definition = "Actions performed to prevent a feared catastrophe or to reduce anxiety in feared situations, which can paradoxically maintain anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral {entity_id: "SB004"}) ON CREATE SET e.name = "Prolonged Sedentary Behavior", e.type = "Symptom_Behavioral", e.definition = "Extended periods of inactivity or low energy expenditure during waking hours, potentially associated with anhedonia or worsening anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA001"}) ON CREATE SET e.name = "Ear Rubbing", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "A self-soothing or displacement activity involving rubbing the ears, potentially indicative of anxiety or stress.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA002"}) ON CREATE SET e.name = "Hair Pulling (as symptom)", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "The act of pulling out one's hair, which can be a symptom of anxiety or a specific disorder (Trichotillomania).", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA003"}) ON CREATE SET e.name = "Hand Tapping", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "Repetitive tapping of the hands or fingers, which can be a manifestation of restlessness or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA004"}) ON CREATE SET e.name = "Nail Biting", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "The compulsive habit of biting one's fingernails, often associated with stress or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA005"}) ON CREATE SET e.name = "Knuckles Cracking", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "The act of manipulating finger joints to produce a cracking sound, sometimes a habitual behavior or a sign of nervous energy.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA006"}) ON CREATE SET e.name = "Nape Rubbing/Scratching", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "Rubbing or scratching the back of the neck, which can be a self-soothing behavior or a sign of discomfort or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA007"}) ON CREATE SET e.name = "Forehead Rubbing/Scratching", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "Rubbing or scratching the forehead, potentially as a response to stress, tension, or worry.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Behavioral_AnxietyDisplay {entity_id: "SA008"}) ON CREATE SET e.name = "Hands Rubbing/Scratching", e.type = "Symptom_Behavioral_AnxietyDisplay", e.definition = "Repetitive rubbing or scratching of the hands, which can be a self-soothing behavior or indicate restlessness or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Emotional {entity_id: "SE001"}) ON CREATE SET e.name = "Fear", e.type = "Symptom_Emotional", e.definition = "An intense emotional response to perceived imminent threat or danger.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Emotional {entity_id: "SE002"}) ON CREATE SET e.name = "Anxiety (Symptom)", e.type = "Symptom_Emotional", e.definition = "A feeling of worry, nervousness, or unease, typically about an imminent event or something with an uncertain outcome. Distinguished from anxiety disorders which are more persistent and impairing.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Emotional {entity_id: "SE003"}) ON CREATE SET e.name = "Irritability", e.type = "Symptom_Emotional", e.definition = "A state of being easily annoyed or angered.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Emotional {entity_id: "SE004"}) ON CREATE SET e.name = "Distress", e.type = "Symptom_Emotional", e.definition = "A general term for unpleasant feelings or emotions that impact one's level of functioning.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Sleep {entity_id: "SS001"}) ON CREATE SET e.name = "Difficulty Falling Asleep", e.type = "Symptom_Sleep", e.definition = "A subjective complaint of prolonged time taken to fall asleep once in bed; a common insomnia symptom.", e.created_at = timestamp();
MERGE (e:Entity:Symptom_Sleep {entity_id: "SS002"}) ON CREATE SET e.name = "Poor Sleep Quality", e.type = "Symptom_Sleep", e.definition = "A subjective perception of one's sleep as unrefreshing, light, or frequently interrupted.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Biological {entity_id: "EB001"}) ON CREATE SET e.name = "Genetic Predisposition", e.type = "Etiology_Biological", e.definition = "An increased likelihood of developing a particular disease or condition based on a person's genetic makeup.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Biological {entity_id: "EB002"}) ON CREATE SET e.name = "HPA Axis Dysregulation", e.type = "Etiology_Biological", e.definition = "Dysfunction in the Hypothalamic-Pituitary-Adrenal (HPA) axis, the body's central stress response system.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Biological {entity_id: "EB003"}) ON CREATE SET e.name = "Neurotransmitter Imbalance", e.type = "Etiology_Biological", e.definition = "A disruption in the normal levels or functioning of neurotransmitters (chemical messengers) in the brain, such as serotonin, GABA, or norepinephrine.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Function_Related {entity_id: "BF001"}) ON CREATE SET e.name = "Amygdala Activity (Altered)", e.type = "Brain_Function_Related", e.definition = "Changes (often hyperactivity) in the amygdala, a brain region central to processing emotions like fear and threat.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Function_Related {entity_id: "BF002"}) ON CREATE SET e.name = "Prefrontal Cortex Activity (Altered)", e.type = "Brain_Function_Related", e.definition = "Changes in the activity of the prefrontal cortex, a brain region involved in executive functions, decision-making, and emotion regulation.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Environmental {entity_id: "EE001"}) ON CREATE SET e.name = "Childhood Adversity", e.type = "Etiology_Environmental", e.definition = "Negative experiences during childhood, such as abuse, neglect, or household dysfunction, that can increase risk for later mental health problems.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Environmental {entity_id: "EE002"}) ON CREATE SET e.name = "Stressful Life Events", e.type = "Etiology_Environmental", e.definition = "Significant life occurrences that cause stress and may trigger or exacerbate anxiety, such as job loss, bereavement, or trauma.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Environmental {entity_id: "EE003"}) ON CREATE SET e.name = "Social/Environmental Change", e.type = "Etiology_Environmental", e.definition = "Significant shifts in an individual's social context or physical surroundings that can induce stress or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Psychological {entity_id: "EP001"}) ON CREATE SET e.name = "Cognitive Biases", e.type = "Etiology_Psychological", e.definition = "Systematic patterns of deviation from norm or rationality in judgment, often leading to inaccurate perceptions or interpretations that can maintain anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Psychological {entity_id: "EP002"}) ON CREATE SET e.name = "Behavioral Inhibition", e.type = "Etiology_Psychological", e.definition = "A temperament trait characterized by a tendency to be shy, fearful, and cautious in novel or unfamiliar situations.", e.created_at = timestamp();
MERGE (e:Entity:Etiology_Psychological {entity_id: "EP003"}) ON CREATE SET e.name = "Learning Experiences (e.g., conditioning)", e.type = "Etiology_Psychological", e.definition = "Past experiences, including classical and operant conditioning, that can shape fear responses and contribute to anxiety development.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP001"}) ON CREATE SET e.name = "Cognitive Behavioral Therapy (CBT)", e.type = "Treatment_Psychotherapy", e.definition = "A type of psychotherapy that helps patients identify and change destructive or disturbing thought patterns that have a negative influence on behavior and emotions.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP002"}) ON CREATE SET e.name = "Exposure Therapy", e.type = "Treatment_Psychotherapy", e.definition = "A psychological treatment that involves exposing the target patient to the anxiety source or its context without the intention to cause any danger, to help them overcome their anxiety or fear.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP003"}) ON CREATE SET e.name = "Exposure and Response Prevention (ERP)", e.type = "Treatment_Psychotherapy", e.definition = "A specific type of CBT used to treat OCD, involving exposure to feared thoughts/situations and refraining from compulsive rituals.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP004"}) ON CREATE SET e.name = "Acceptance and Commitment Therapy (ACT)", e.type = "Treatment_Psychotherapy", e.definition = "A form of psychotherapy that uses acceptance and mindfulness strategies mixed in different ways with commitment and behavior-change strategies, to increase psychological flexibility.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP005"}) ON CREATE SET e.name = "Mindfulness-Based Interventions", e.type = "Treatment_Psychotherapy", e.definition = "Therapeutic approaches that incorporate mindfulness meditation to help individuals manage stress, anxiety, and other emotional difficulties by fostering present-moment awareness.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP006"}) ON CREATE SET e.name = "Psychodynamic Therapy", e.type = "Treatment_Psychotherapy", e.definition = "A form of in-depth talk therapy that focuses on unconscious processes as they are manifested in a person's present behavior.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP007"}) ON CREATE SET e.name = "Unified Protocol (UP)", e.type = "Treatment_Psychotherapy", e.definition = "A transdiagnostic cognitive-behavioral treatment designed to address the common underlying factors of emotional disorders, including anxiety and depressive disorders.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Psychotherapy {entity_id: "TP008"}) ON CREATE SET e.name = "Sleep Hygiene Education", e.type = "Treatment_Psychotherapy", e.definition = "Providing education and strategies to promote healthy sleep habits, often a component of CBT for insomnia or anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Medication_Class {entity_id: "MC001"}) ON CREATE SET e.name = "SSRIs (Selective Serotonin Reuptake Inhibitors)", e.type = "Medication_Class", e.definition = "A class of antidepressant drugs that increase the levels of serotonin in the brain, commonly used for anxiety disorders.", e.created_at = timestamp();
MERGE (e:Entity:Medication_Class {entity_id: "MC002"}) ON CREATE SET e.name = "SNRIs (Serotonin-Norepinephrine Reuptake Inhibitors)", e.type = "Medication_Class", e.definition = "A class of antidepressant drugs that increase levels of serotonin and norepinephrine in the brain, also used for anxiety disorders.", e.created_at = timestamp();
MERGE (e:Entity:Medication_Class {entity_id: "MC003"}) ON CREATE SET e.name = "Benzodiazepines", e.type = "Medication_Class", e.definition = "A class of psychoactive drugs used to treat a range of conditions, including anxiety and insomnia, by enhancing the effect of GABA. Typically for short-term use due to dependence risk.", e.created_at = timestamp();
MERGE (e:Entity:Medication_Class {entity_id: "MC004"}) ON CREATE SET e.name = "TCAs (Tricyclic Antidepressants)", e.type = "Medication_Class", e.definition = "An older class of antidepressant medications, sometimes used for anxiety disorders if other treatments are ineffective.", e.created_at = timestamp();
MERGE (e:Entity:Medication_Class {entity_id: "MC005"}) ON CREATE SET e.name = "MAOIs (Monoamine Oxidase Inhibitors)", e.type = "Medication_Class", e.definition = "An older class of antidepressants that require dietary restrictions, used less frequently for anxiety disorders due to side effects and interactions.", e.created_at = timestamp();
MERGE (e:Entity:Medication_Class {entity_id: "MC006"}) ON CREATE SET e.name = "Beta-Blockers", e.type = "Medication_Class", e.definition = "Medications that reduce blood pressure and can be used to manage physical symptoms of anxiety, such as rapid heartbeat, particularly for performance anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD001"}) ON CREATE SET e.name = "Sertraline", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "An SSRI medication commonly prescribed for depression, anxiety disorders (like GAD, SAD, PD, PTSD), and OCD.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD002"}) ON CREATE SET e.name = "Paroxetine", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "An SSRI medication used to treat depression, anxiety disorders (like GAD, SAD, PD, PTSD), and OCD.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD003"}) ON CREATE SET e.name = "Fluoxetine", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "An SSRI medication used for depression, panic disorder, OCD, and bulimia nervosa.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD004"}) ON CREATE SET e.name = "Venlafaxine", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "An SNRI medication used to treat depression, GAD, SAD, and panic disorder.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD005"}) ON CREATE SET e.name = "Duloxetine", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "An SNRI medication used for depression, GAD, fibromyalgia, and neuropathic pain.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD006"}) ON CREATE SET e.name = "Alprazolam", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "A benzodiazepine medication used for the short-term management of anxiety disorders, especially panic disorder and GAD.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD007"}) ON CREATE SET e.name = "Diazepam", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "A benzodiazepine medication used to treat anxiety, muscle spasms, seizures, and alcohol withdrawal.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Pharmacotherapy_Drug {entity_id: "TD008"}) ON CREATE SET e.name = "Buspirone", e.type = "Treatment_Pharmacotherapy_Drug", e.definition = "An anxiolytic drug primarily used to treat GAD, works differently from benzodiazepines and is not associated with dependence.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Neurostimulation {entity_id: "TN001"}) ON CREATE SET e.name = "Repetitive Transcranial Magnetic Stimulation (rTMS)", e.type = "Treatment_Neurostimulation", e.definition = "A non-invasive brain stimulation technique that uses magnetic pulses to stimulate specific areas of the brain, explored for treatment-resistant anxiety and depression.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Neurostimulation {entity_id: "TN002"}) ON CREATE SET e.name = "Transcranial Direct Current Stimulation (tDCS)", e.type = "Treatment_Neurostimulation", e.definition = "A non-invasive brain stimulation technique that applies a weak electrical current to the scalp to modulate brain activity, investigated for various neurological and psychiatric conditions.", e.created_at = timestamp();
MERGE (e:Entity:Treatment_Neurostimulation {entity_id: "TN003"}) ON CREATE SET e.name = "Vagus Nerve Stimulation (VNS)", e.type = "Treatment_Neurostimulation", e.definition = "A medical treatment that involves delivering electrical impulses to the vagus nerve, used for epilepsy and treatment-resistant depression, with some research in anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Method {entity_id: "MM001"}) ON CREATE SET e.name = "Human Activity Recognition (HAR)", e.type = "Monitoring_Method", e.definition = "The process of identifying human actions from sensor data, potentially applicable to detecting anxiety-related behaviors.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Tool_Type {entity_id: "MTT001"}) ON CREATE SET e.name = "Wearable Sensors", e.type = "Monitoring_Tool_Type", e.definition = "Electronic devices worn on the body that can detect and transmit information about physiological states or motion, used for health monitoring.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Tool_Type {entity_id: "MTT002"}) ON CREATE SET e.name = "Motion Sensors (General)", e.type = "Monitoring_Tool_Type", e.definition = "Devices that detect physical movement, including accelerometers and gyroscopes, used in HAR and anxiety monitoring research.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Sensor {entity_id: "MS001"}) ON CREATE SET e.name = "Accelerometer", e.type = "Monitoring_Sensor", e.definition = "A sensor that measures proper acceleration, used in wearable devices to detect movement, activity levels, and specific gestures.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Sensor {entity_id: "MS002"}) ON CREATE SET e.name = "Gyroscope", e.type = "Monitoring_Sensor", e.definition = "A sensor that measures orientation and angular velocity, used in wearable devices to provide more detailed motion tracking.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Method {entity_id: "MM002"}) ON CREATE SET e.name = "Self-Report Questionnaires", e.type = "Monitoring_Method", e.definition = "Assessments where individuals provide information about their own thoughts, feelings, or behaviors, a common method for anxiety assessment.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Method {entity_id: "MM003"}) ON CREATE SET e.name = "Ecological Momentary Assessment (EMA)", e.type = "Monitoring_Method", e.definition = "A research method that involves repeated sampling of subjects' current behaviors and experiences in real time, in their natural environments.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_AssessmentTool {entity_id: "MA001"}) ON CREATE SET e.name = "Penn State Worry Questionnaire (PSWQ)", e.type = "Monitoring_AssessmentTool", e.definition = "A self-report measure designed to assess the trait of worry, particularly its excessiveness, uncontrollability, and generality.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_AssessmentTool {entity_id: "MA002"}) ON CREATE SET e.name = "Hamilton Anxiety Rating Scale (HAM-A)", e.type = "Monitoring_AssessmentTool", e.definition = "A clinician-rated scale used to assess the severity of anxiety symptoms in adults.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_AssessmentTool {entity_id: "MA003"}) ON CREATE SET e.name = "GAD-7 Scale", e.type = "Monitoring_AssessmentTool", e.definition = "A brief self-report questionnaire used for screening and measuring the severity of Generalized Anxiety Disorder.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_AssessmentTool {entity_id: "MA004"}) ON CREATE SET e.name = "Beck Anxiety Inventory (BAI)", e.type = "Monitoring_AssessmentTool", e.definition = "A self-report measure of anxiety severity, focusing more on somatic symptoms.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_AssessmentTool {entity_id: "MA005"}) ON CREATE SET e.name = "Yale-Brown Obsessive-Compulsive Scale (Y-BOCS)", e.type = "Monitoring_AssessmentTool", e.definition = "A clinician-rated instrument used to assess the severity of symptoms in Obsessive-Compulsive Disorder.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_AssessmentTool {entity_id: "MA006"}) ON CREATE SET e.name = "Social Phobia Inventory (SPIN)", e.type = "Monitoring_AssessmentTool", e.definition = "A self-report questionnaire designed to measure the severity of social anxiety disorder (social phobia).", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Biomarker {entity_id: "MB001"}) ON CREATE SET e.name = "Resting Heart Rate (RHR)", e.type = "Monitoring_Biomarker", e.definition = "The number of times the heart beats per minute while at complete rest; can be an indicator of cardiovascular health and stress levels.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Biomarker {entity_id: "MB002"}) ON CREATE SET e.name = "Cortisol Levels", e.type = "Monitoring_Biomarker", e.definition = "The concentration of cortisol, a stress hormone produced by the adrenal glands, which can be measured in saliva, blood, or urine as an indicator of HPA axis activity.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Biomarker {entity_id: "MB003"}) ON CREATE SET e.name = "Heart Rate Variability (HRV)", e.type = "Monitoring_Biomarker", e.definition = "The variation in the time interval between consecutive heartbeats, reflecting autonomic nervous system function and often altered in anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Monitoring_Biomarker {entity_id: "MB004"}) ON CREATE SET e.name = "Electrodermal Activity (EDA)", e.type = "Monitoring_Biomarker", e.definition = "Changes in the electrical properties of the skin in response to sweat secretion, an indicator of physiological arousal often used in anxiety research.", e.created_at = timestamp();
MERGE (e:Entity:Physiological_Event {entity_id: "PE001"}) ON CREATE SET e.name = "Heart Rate Spike", e.type = "Physiological_Event", e.definition = "A sudden, temporary increase in heart rate, often in response to a stressor, physical exertion, or during a panic-like episode.", e.created_at = timestamp();
MERGE (e:Entity:Key_Concept {entity_id: "KC001"}) ON CREATE SET e.name = "Anxiety Sensitivity", e.type = "Key_Concept", e.definition = "The fear of anxiety-related sensations, based on beliefs that these sensations have harmful somatic, psychological, or social consequences.", e.created_at = timestamp();
MERGE (e:Entity:Key_Concept {entity_id: "KC002"}) ON CREATE SET e.name = "Experiential Avoidance", e.type = "Key_Concept", e.definition = "The attempt to avoid thoughts, feelings, memories, physical sensations, and other internal experiences—even when doing so creates harm in the long-run.", e.created_at = timestamp();
MERGE (e:Entity:Key_Concept {entity_id: "KC003"}) ON CREATE SET e.name = "Cognitive Fusion", e.type = "Key_Concept", e.definition = "A state where thoughts are perceived as literal truths or commands that must be followed, rather than as transient mental events.", e.created_at = timestamp();
MERGE (e:Entity:Key_Concept {entity_id: "KC004"}) ON CREATE SET e.name = "Attentional Bias", e.type = "Key_Concept", e.definition = "The tendency for an individual's perception to be affected by their current recurring thoughts, often involving a heightened attention to threat-related stimuli in anxious individuals.", e.created_at = timestamp();
MERGE (e:Entity:Key_Concept {entity_id: "KC005"}) ON CREATE SET e.name = "Baseline Level", e.type = "Key_Concept", e.definition = "A reference point representing an individual's typical state or measurement (e.g., activity, physiological) used for comparison to detect changes or deviations.", e.created_at = timestamp();
MERGE (e:Entity:Neurotransmitter {entity_id: "NT001"}) ON CREATE SET e.name = "Serotonin", e.type = "Neurotransmitter", e.definition = "A neurotransmitter involved in regulating mood, sleep, appetite, and other functions; imbalances are implicated in anxiety and depression.", e.created_at = timestamp();
MERGE (e:Entity:Neurotransmitter {entity_id: "NT002"}) ON CREATE SET e.name = "Norepinephrine", e.type = "Neurotransmitter", e.definition = "A neurotransmitter and hormone involved in the body's stress response (fight-or-flight); implicated in anxiety disorders.", e.created_at = timestamp();
MERGE (e:Entity:Neurotransmitter {entity_id: "NT003"}) ON CREATE SET e.name = "GABA (Gamma-Aminobutyric Acid)", e.type = "Neurotransmitter", e.definition = "The primary inhibitory neurotransmitter in the brain, reducing neuronal excitability; dysfunction is linked to anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Neurotransmitter {entity_id: "NT004"}) ON CREATE SET e.name = "Dopamine", e.type = "Neurotransmitter", e.definition = "A neurotransmitter involved in reward, motivation, and motor control; its role in anxiety is complex and less direct than other neurotransmitters but still relevant.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Region {entity_id: "BR001"}) ON CREATE SET e.name = "Ventromedial Prefrontal Cortex (vmPFC)", e.type = "Brain_Region", e.definition = "A part of the prefrontal cortex involved in emotion regulation, decision-making, and the extinction of fear responses.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Region {entity_id: "BR002"}) ON CREATE SET e.name = "Dorsolateral Prefrontal Cortex (dlPFC)", e.type = "Brain_Region", e.definition = "A part of the prefrontal cortex involved in executive functions like working memory, cognitive flexibility, and planning; implicated in anxiety regulation.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Region {entity_id: "BR003"}) ON CREATE SET e.name = "Amygdala", e.type = "Brain_Region", e.definition = "An almond-shaped set of neurons located deep in the brain's medial temporal lobe, playing a key role in processing emotions, especially fear.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Region {entity_id: "BR004"}) ON CREATE SET e.name = "Hippocampus", e.type = "Brain_Region", e.definition = "A brain structure primarily associated with memory formation and spatial navigation; involved in contextual fear conditioning and PTSD.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Region {entity_id: "BR005"}) ON CREATE SET e.name = "Anterior Cingulate Cortex (ACC)", e.type = "Brain_Region", e.definition = "A brain region involved in error detection, conflict monitoring, motivation, and emotion regulation; often shows altered activity in anxiety disorders.", e.created_at = timestamp();
MERGE (e:Entity:Brain_Region {entity_id: "BR006"}) ON CREATE SET e.name = "Insula", e.type = "Brain_Region", e.definition = "A brain region involved in interoception (awareness of internal bodily states), emotional awareness, and self-consciousness; implicated in anxiety and panic.", e.created_at = timestamp();
MERGE (e:Entity:Gene {entity_id: "GE001"}) ON CREATE SET e.name = "RBFOX1 Gene", e.type = "Gene", e.definition = "A gene involved in neural development and synaptic function; variations have been linked to an increased risk for anxiety disorders.", e.created_at = timestamp();
MERGE (e:Entity:Gene {entity_id: "GE002"}) ON CREATE SET e.name = "COMT Gene", e.type = "Gene", e.definition = "A gene that provides instructions for making an enzyme called catechol-O-methyltransferase, which is involved in the breakdown of neurotransmitters like dopamine and norepinephrine; variations are studied in relation to anxiety.", e.created_at = timestamp();
MERGE (e:Entity:Gene {entity_id: "GE003"}) ON CREATE SET e.name = "SLC6A4 Gene (Serotonin Transporter)", e.type = "Gene", e.definition = "A gene that codes for the serotonin transporter protein, which regulates serotonin levels; variations (e.g., 5-HTTLPR polymorphism) are widely studied in relation to anxiety and depression.", e.created_at = timestamp();
MERGE (e:Entity:Gene {entity_id: "GE004"}) ON CREATE SET e.name = "BDNF Gene (Brain-Derived Neurotrophic Factor)", e.type = "Gene", e.definition = "A gene that codes for a protein involved in neuron growth, survival, and differentiation; implicated in neuroplasticity and linked to anxiety and mood disorders.", e.created_at = timestamp();
MERGE (e:Entity:Gene {entity_id: "GE005"}) ON CREATE SET e.name = "ITM2B Gene", e.type = "Gene", e.definition = "A gene whose variants have been associated with anxiety disorders in some genetic studies.", e.created_at = timestamp();

